<misterromdescription>
    <name>Exciting Soccer (bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Exciting Soccer</series>
    <year>1983</year>
    <manufacturer>bootleg (Kazutomi)</manufacturer>
    <category>Sports</category>

    <setname>exctsccrb</setname>
    <parent>exctsccr</parent>
    <mameversion>0270</mameversion>
    <rbf>ChampionBaseball</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Kick,Chase,Coin,Start 1P,Start 2P,Pause" default="A,B,Select,Start,R,L"/>

    <!-- DIPs derived from MAME INPUT_PORTS(exctsccr), champbas.cpp:794 (PORT_INCLUDE(talbot) + overrides).
         exctsccrb reuses this same table (see GAME(exctsccrb,...,exctsccr,...) in champbas.cpp).
         ids are indexed by the RAW value of the bit range, not MAME's PORT_DIPSETTING print order — that
         is why Demo Sounds/Cabinet/Difficulty list what looks like the "wrong" label first, and why Game
         Time's ids read 2/1/4/3 Min. instead of numeric order (raw bits[6:5]: 0=2 Min., 1=1 Min., 2=4 Min.,
         3=3 Min.). bits="lo,hi" is an inclusive RANGE, not a list.
         DSW bit 7 is deliberately absent: it is NOT a dip, it is watchdog_bit2() (champbas.cpp:487)
         read back through this port, and must be driven by the core's watchdog counter.
         Composite default = 0x03 (coinage A1C/1C B3C/1C) | 0x00 (demo on) | 0x00 (cabinet upright) |
         0x10 (difficulty easy) | 0x00 (game time 2 min.) = 0x13.
         UNVERIFIED: polarities/default derived from source, not yet confirmed on the test screen. -->
    <switches default="13">
        <dip bits="0,1" name="Coinage" ids="A 1C/3C B 1C/6C,A 1C/2C B 1C/4C,2C/1C,A 1C/1C B 3C/1C"/>
        <dip bits="2"   name="Demo Sounds" ids="On,Off"/>
        <dip bits="3"   name="Cabinet" ids="Upright,Cocktail"/>
        <dip bits="4"   name="Difficulty" ids="Hard,Easy"/>
        <dip bits="5,6" name="Game Time" ids="2 Min.,1 Min.,4 Min.,3 Min."/>
    </switches>

    <!-- Kazutomi bootleg: a conversion running on a modified Champion Baseball board (champbas.cpp:67-69,
         1561-1576) — the original Exciting Soccer board's improved sound hardware is missing here, hence
         its own maincpu/audiocpu ROMs distinct from exctsccr's. Merged set: all parts below live in the
         parent exctsccr.zip (verified present via unzip -l, member NAMES only, per the ROM-data-is-ground-
         truth rule — contents never inspected). -->

    <!-- Index 0: Main CPU ROMs (0x6000) -->
    <rom index="0" md5="none" zip="exctsccr.zip">
        <part crc="997c6a82" name="es-1.e2"/>
        <part crc="5c66e792" name="es-2.g2"/>
        <part crc="e0d504c0" name="es-3.h2"/>
    </rom>

    <!-- Index 1: Sound CPU ROMs (0x6000) -->
    <rom index="1" md5="none" zip="exctsccr.zip">
        <part crc="99e87b78" name="es-a.k2"/>
        <part crc="8b3db794" name="es-b.l2"/>
        <part crc="7bed2f81" name="es-c.m2"/>
    </rom>

    <!-- Index 2: GFX planes 0/1 (0x4000), de-interleaved here so the core loader stays dumb.
         Reproduces the planes-0/1 half of init_exctsccr() (champbas.cpp:1666), which swaps the upper half
         of gfx1's plane0/1 ROM (4_a5.bin) with the lower half of gfx2's plane0/1 ROM (5_b5.bin). These are
         the SAME gfx ROMs (name and CRC) as exctsccr's own — the national flags are wrong on this bootleg
         but that is a documented real-hardware behavior (champbas.cpp:1591), not a bad dump.
         Same shape as the champbas-family index 2. Core splits this index on ioctl_addr[13]:
           0x0000-0x1FFF = chars   planes 0,1
           0x2000-0x3FFF = sprites planes 0,1
         The plane-3 nibble rearrangement (same init_exctsccr()) is a nibble split, not a byte-range split,
         and cannot be expressed by an MRA offset/length — see index 8. -->
    <rom index="2" md5="none" zip="exctsccr.zip">
        <part crc="c342229b" name="4_a5.bin" offset="0x0000" length="0x1000"/>
        <part crc="35f4f8c9" name="5_b5.bin" offset="0x0000" length="0x1000"/>
        <part crc="c342229b" name="4_a5.bin" offset="0x1000" length="0x1000"/>
        <part crc="35f4f8c9" name="5_b5.bin" offset="0x1000" length="0x1000"/>
    </rom>

    <!-- Index 6: ALPHA-8201 MCU ROM (alpha_8201:mcu region, 0x2000). ROM_START(exctsccrb) does define this
         region (same file/CRC as talbot's), so it is emitted here, but per the task brief this bootleg
         runs on modified Champion Baseball hardware where the 8201 is present but UNUSED — flagged as
         such, not omitted, since the region exists in source. -->
    <rom index="6" md5="none" zip="exctsccr.zip">
        <part crc="b77931ac" name="alpha-8201_44801a75_2f25.bin"/>
    </rom>

    <!-- Index 7: PROMs (0x220), same as exctsccr's -->
    <rom index="7" md5="none" zip="exctsccr.zip">
        <part crc="d9b10bf0" name="prom1.e1"/>
        <part crc="b5db1c2c" name="prom3.k5"/>
        <part crc="8a9c0edf" name="prom2.8r"/>
    </rom>

    <!-- Index 8: gfx1's plane-3 source ROM (6_c5.bin, the SECOND ROM in the "gfx1" ROM_REGION), loaded
         VERBATIM with no offset/length. init_exctsccr() (champbas.cpp:1680-1690) turns this single byte
         source into two nibble-addressed destination bytes — an MRA cannot express a nibble split, so the
         RTL is expected to do the nibble select at render time from this verbatim ROM image.
         DO NOT attempt to reproduce the nibble split here. -->
    <rom index="8" md5="none" zip="exctsccr.zip">
        <part crc="eda40e32" name="6_c5.bin"/>
    </rom>

    <!-- Index 9: gfx3, 4bpp sprites (0x2000), verbatim, using exctsccrb's own ROM_START names
         (2_k5.bin / 3_l5.bin — same CRCs as exctsccr's 2.5k / 3.5l, but stored as separate zip members). -->
    <rom index="9" md5="none" zip="exctsccr.zip">
        <part crc="7f9cace2" name="2_k5.bin"/>
        <part crc="db2d9e0d" name="3_l5.bin"/>
    </rom>

    <!-- Index 5: game-select byte, plain enumeration (see Champion Base Ball.mra header for the full table). -->
    <rom index="5"><part>0A</part></rom>

    <remark>Exciting Soccer (bootleg, Kazutomi) — champbas.cpp</remark>
    <mratimestamp>20260730000000</mratimestamp>
</misterromdescription>
