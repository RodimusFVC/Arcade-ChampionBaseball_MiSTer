<misterromdescription>
    <name>Exciting Soccer II</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Exciting Soccer</series>
    <year>1984</year>
    <manufacturer>Alpha Denshi Co.</manufacturer>
    <category>Sports</category>

    <setname>exctscc2</setname>
    <parent>exctscc2</parent>
    <mameversion>0270</mameversion>
    <rbf>ChampionBaseball</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Kick,Chase,Not Used,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Select,Start,R,L"/>

    <!-- DIPs derived from MAME INPUT_PORTS(exctsccr), champbas.cpp:794 (PORT_INCLUDE(talbot) + overrides).
         exctscc2 reuses this same table (see GAME(exctscc2,...,exctsccr,...) in champbas.cpp).
         ids are indexed by the RAW value of the bit range, not MAME's PORT_DIPSETTING print order — that
         is why Demo Sounds/Cabinet/Difficulty list what looks like the "wrong" label first, and why Game
         Time's ids read 2/1/4/3 Min. instead of numeric order (raw bits[6:5]: 0=2 Min., 1=1 Min., 2=4 Min.,
         3=3 Min.). bits="lo,hi" is an inclusive RANGE, not a list.
         DSW bit 7 is deliberately absent: it is NOT a dip, it is watchdog_bit2() (champbas.cpp:487)
         read back through this port, and must be driven by the core's watchdog counter.
         Composite default = 0x03 (coinage A1C/1C B3C/1C) | 0x00 (demo on) | 0x00 (cabinet upright) |
         0x10 (difficulty easy) | 0x00 (game time 2 min.) = 0x13.
         UNVERIFIED: polarities/default derived from source, not yet confirmed on the test screen. -->
    <switches default="13">
        <dip bits="0,1" name="Coinage" ids="A 1C/3C B 1C/6C,A 1C/2C B 1C/4C,2C/1C,A 1C/1C B 3C/1C"/>
        <dip bits="2"   name="Demo Sounds" ids="On,Off"/>
        <dip bits="3"   name="Cabinet" ids="Upright,Cocktail"/>
        <dip bits="4"   name="Difficulty" ids="Hard,Easy"/>
        <dip bits="5,6" name="Game Time" ids="2 Min.,1 Min.,4 Min.,3 Min."/>
    </switches>

    <!-- Index 0: Main CPU ROMs (0x6000), on the CPU & sound board -->
    <rom index="0" md5="none" zip="exctscc2.zip">
        <part crc="c6115362" name="eprom_1_vr_b_alpha_denshi.3j"/>
        <part crc="de36ba00" name="eprom_2_vr_alpha_denshi.3k"/>
        <part crc="1ddfdf65" name="eprom_3_vr_v_alpha_denshi.3l"/>
    </rom>

    <!-- Index 1: Sound CPU ROMs (0x9000), on the CPU & sound board -->
    <rom index="1" md5="none" zip="exctscc2.zip">
        <part crc="2c675a43" name="eprom_0_vr_alpha_denshi.7d"/>
        <part crc="e571873d" name="eprom_9_vr_alpha_denshi.7e"/>
        <part crc="88651ee1" name="eprom_8_vr_alpha_denshi.7f"/>
        <part crc="6d51521e" name="eprom_7_vr_alpha_denshi.7h"/>
        <part crc="20f2207e" name="eprom_1_vr_alpha_denshi.7k"/>
    </rom>

    <!-- Index 2: GFX planes 0/1 (0x4000), de-interleaved here so the core loader stays dumb.
         Reproduces the planes-0/1 half of init_exctsccr() (champbas.cpp:1666), which swaps the upper half
         of gfx1's plane0/1 ROM (eprom_4...5a) with the lower half of gfx2's plane0/1 ROM (eprom_5...5b).
         Same shape as the champbas-family index 2. Core splits this index on ioctl_addr[13]:
           0x0000-0x1FFF = chars   planes 0,1
           0x2000-0x3FFF = sprites planes 0,1
         The plane-3 nibble rearrangement (same init_exctsccr()) is a nibble split, not a byte-range split,
         and cannot be expressed by an MRA offset/length — see index 8. -->
    <rom index="2" md5="none" zip="exctscc2.zip">
        <part crc="4ff1783d" name="eprom_4_vr_alpha_denshi.5a" offset="0x0000" length="0x1000"/>
        <part crc="5605b60b" name="eprom_5_vr_alpha_denshi.5b" offset="0x0000" length="0x1000"/>
        <part crc="4ff1783d" name="eprom_4_vr_alpha_denshi.5a" offset="0x1000" length="0x1000"/>
        <part crc="5605b60b" name="eprom_5_vr_alpha_denshi.5b" offset="0x1000" length="0x1000"/>
    </rom>

    <!-- Index 6: ALPHA-8201 MCU ROM (alpha_8201:mcu region, 0x2000), on the CPU & sound board. -->
    <rom index="6" md5="none" zip="exctscc2.zip">
        <part crc="66adcb37" name="alpha-8303_44801b42.1d"/>
    </rom>

    <!-- Index 7: PROMs (0x220), colors match video captured from PCB.
           0x000-0x01F = tbp18s030.5j, 32 x 8  palette (marked 7051 on CPU & sound board)
           0x020-0x11F = tbp24s10.61d, 256 x 8 pen->color lookup table (marked 7052 on display board)
           0x120-0x21F = tbp24s10.60h, 256 x 8 pen->color lookup table (marked 7052 on display board) -->
    <rom index="7" md5="none" zip="exctscc2.zip">
        <part crc="899d153d" name="tbp18s030.5j"/>
        <part crc="75613784" name="tbp24s10.61d"/>
        <part crc="1a52d6eb" name="tbp24s10.60h"/>
    </rom>

    <!-- Index 8: gfx1's plane-3 source ROM (eprom_6...5c, the SECOND ROM in the "gfx1" ROM_REGION), loaded
         VERBATIM with no offset/length. init_exctsccr() (champbas.cpp:1680-1690) turns this single byte
         source into two nibble-addressed destination bytes — an MRA cannot express a nibble split, so the
         RTL is expected to do the nibble select at render time from this verbatim ROM image.
         DO NOT attempt to reproduce the nibble split here. -->
    <rom index="8" md5="none" zip="exctscc2.zip">
        <part crc="1fb84ee6" name="eprom_6_vr_alpha_denshi.5c"/>
    </rom>

    <!-- Index 9: gfx3, 4bpp sprites (0x2000), verbatim in ROM_START order, on the display board. -->
    <rom index="9" md5="none" zip="exctscc2.zip">
        <part crc="1d37edfa" name="eprom_7_vr_alpha_denshi.5k"/>
        <part crc="b97f396c" name="eprom_8_vr_alpha_denshi.5l"/>
    </rom>

    <!-- Index 5: game-select byte, plain enumeration (see Champion Base Ball.mra header for the full table). -->
    <rom index="5"><part>09</part></rom>

    <remark>Exciting Soccer II (Alpha Denshi) — champbas.cpp</remark>
    <mratimestamp>20260730000000</mratimestamp>
</misterromdescription>
