<misterromdescription>
    <name>Champion Base Ball (Japan set 2)</name>
    <region>Japan</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Champion Base Ball</series>
    <year>1983</year>
    <manufacturer>Alpha Denshi Co.</manufacturer>
    <category>Sports</category>

    <setname>champbasja</setname>
    <parent>champbas</parent>
    <mameversion>0270</mameversion>
    <rbf>ChampionBaseball</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>3</num_buttons>
    <buttons names="Throw,Steal,Changes,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Select,Start,R,L"/>

    <!-- DIPs derived from MAME INPUT_PORTS(champbas), champbas.cpp:758 (PORT_INCLUDE(talbot) + overrides).
         ids are indexed by the RAW value of the bit range, so single-bit entries list the value-0 label
         FIRST — Flip Screen / Demo Sounds / Difficulty therefore read "backwards" vs MAME's print order
         and are correct as written. bits="lo,hi" is an inclusive RANGE, not a list.
         DSW bit 7 is deliberately absent: it is NOT a dip, it is watchdog_bit2() (champbas.cpp:487)
         read back through this port, and must be driven by the core's watchdog counter.
         Composite default = 0x02 (coinage) | 0x04 (flip off) | 0x20 (easy) = 0x26.
         UNVERIFIED: polarities/default derived from source, not yet confirmed on the test screen. -->
    <switches default="26">
        <dip bits="0,1" name="Coinage" ids="A 1C/3C B 1C/6C,A 1C/2C B 1C/6C,A 1C/1C B 2C/1C,A 2C/1C B 3C/2C"/>
        <dip bits="2"   name="Flip Screen" ids="On,Off"/>
        <dip bits="3"   name="Demo Sounds" ids="On,Off"/>
        <dip bits="4"   name="Cabinet" ids="Upright,Cocktail"/>
        <dip bits="5"   name="Difficulty" ids="Hard,Easy"/>
    </switches>

    <!-- Index 0: Main CPU ROMs (0x6000) -->
    <rom index="0" md5="none" zip="champbas.zip">
        <part crc="f7cdaf8e" name="10"/>
        <part crc="9d39e5b3" name="09"/>
        <part crc="53468a0f" name="08"/>
    </rom>

    <!-- Index 1: Sound CPU ROMs (0x6000) -->
    <rom index="1" md5="none" zip="champbas.zip">
        <part crc="24c482ee" name="16.2k"/>
        <part crc="f10b148b" name="17.2l"/>
        <part crc="2dc484dd" name="18.2n"/>
    </rom>

    <!-- Index 2: GFX (0x4000), de-interleaved here so the core loader stays dumb.
         Reproduces init_champbas() (champbas.cpp:1650), which swaps the upper half of gfx1 with the
         lower half of gfx2 because chars and sprites are mixed across both ROMs.
         Core splits this index on ioctl_addr[13]:
           0x0000-0x1FFF = chars   (8x8, 2bpp, 16 bytes/tile, 512 tiles)
           0x2000-0x3FFF = sprites (16x16, 2bpp, 64 bytes/sprite, 128 sprites) -->
    <rom index="2" md5="none" zip="champbas.zip">
        <part crc="1b8202b3" name="14.5e" offset="0x0000" length="0x1000"/>
        <part crc="a67c0c40" name="15.5g" offset="0x0000" length="0x1000"/>
        <part crc="1b8202b3" name="14.5e" offset="0x1000" length="0x1000"/>
        <part crc="a67c0c40" name="15.5g" offset="0x1000" length="0x1000"/>
    </rom>

    <!-- Index 7: PROMs (0x120).
           0x000-0x01F = champbb.pr2, 32 x 8  palette (resnet: R/G 1k/470/220, B 470/220)
           0x020-0x11F = champbb.pr1, 256 x 8 pen->color lookup (low nibble used) -->
    <rom index="7" md5="none" zip="champbas.zip">
        <part crc="8f989357" name="clr"/>
        <part crc="2e481ffa" name="5k.bpr"/>
    </rom>

    <!-- Index 5: game-select byte. Plain enumeration, not a bitfield:
           0x00 champbas    0x01 champbasj   0x02 champbasja  0x03 champbasjb
           0x04 champbb2    0x05 champbb2j   0x06 tbasebal    0x07 talbot
           0x08 exctsccr    0x09 exctscc2    0x0A exctsccrb
         champbasja = 0x02. Core adds RAM at 0x6000-0x63FF plus the address-derived
         fake protection read at 0x6800-0x68FF (champbas.cpp:532). NO MCU. -->
    <rom index="5"><part>02</part></rom>

    <remark>Champion Base Ball (Japan set 2) — simplified protection, no MCU</remark>
    <mratimestamp>20260730000000</mratimestamp>
</misterromdescription>
