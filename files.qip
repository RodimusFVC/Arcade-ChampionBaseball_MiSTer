set_global_assignment -name VHDL_INPUT_VERSION VHDL_2008

set_global_assignment -name SYSTEMVERILOG_FILE Arcade-ChampionBaseball.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ChampionBaseball.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ChampionBaseball_CPU.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ChampionBaseball_SND.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ChampionBaseball_VIDEO.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ChampionBaseball_MAIN.sv

set_global_assignment -name QIP_FILE rtl/cpu/T80/T80.qip
set_global_assignment -name QIP_FILE rtl/sound/v_sound.qip

set_global_assignment -name VERILOG_FILE rtl/pause.v
set_global_assignment -name VERILOG_FILE rtl/nvram.v
set_global_assignment -name VERILOG_FILE rtl/hiscore.v

# MB88-SV-SWAP-2026-07-10: replaced darfpga mb88.vhd (BRAM-RAM read-after-write hazard
# hangs the K-debounce) with the validated combinational-RAM SV core + drop-in wrapper.
# To REVERT: uncomment the VHDL line below, remove the two SYSTEMVERILOG_FILE lines.
# set_global_assignment -name VHDL_FILE rtl/cpu/mb88.vhd
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/mb88_sv/mb88_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/mb88_sv/mb88.sv

# MCU-INTEGRATE-2026-08-01: ALPHA-8201 (HD44801 / HMCS44) for champbasj, talbot,
# exctsccr and exctscc2. Instantiated in ChampionBaseball_MAIN.sv, gated on
# set_has_mcu — exctsccrb is deliberately NOT in that list (8201 fitted but
# unused, and that set already works on plain RAM).
# To REVERT: comment these three out, tie MAIN's mcu_addr/mcu_data off in
# rtl/ChampionBaseball.sv, and drop the alpha8201 instance from MAIN.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/hmcs40/hmcs40_decoder.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/hmcs40/hmcs40.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/cpu/hmcs40/alpha8201.sv

set_global_assignment -name VHDL_FILE rtl/ram_rom/dpram_dc.vhd
set_global_assignment -name VHDL_FILE rtl/ram_rom/spram.vhd
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ram_rom/rom_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ram_rom/champbas_rom.sv

set_global_assignment -name VERILOG_FILE rtl/pll.v
set_global_assignment -name VERILOG_FILE rtl/pll/pll_0002.v